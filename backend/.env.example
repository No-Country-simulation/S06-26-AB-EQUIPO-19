# Copie este arquivo para .env e preencha com suas credenciais locais
# NUNCA suba o arquivo .env para o repositório

# Porta do servidor
PORT=8080

# Banco de dados MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD= # sua senha do MySQL
DB_NAME=appbit_hackathon

# Conexão completa (alternativa ao DB_USER/DB_PASSWORD separados)
# DATABASE_URL=mysql+mysqlconnector://usuario:senha@localhost:3306/appbit_hackathon

# Chave da API do Google AI Studio (Gemini)
# Obtenha em: https://aistudio.google.com
IA_API_KEY=
